# Publishable key ถูกออกแบบมาให้เปิดเผยได้ — Vite ฝังตัวแปร VITE_* ลง bundle
# ที่ส่งให้เบราว์เซอร์อยู่แล้ว ใครเปิด devtools ก็เห็น
# ตัวที่กันข้อมูลจริงคือ RLS ไม่ใช่การซ่อนคีย์
#
# ⛔ Secret key (sb_secret_...) ห้ามอยู่ในไฟล์นี้เด็ดขาด
#    ถ้าต้องใช้ ให้ไปอยู่ใน Cloudflare Worker secret ฝั่ง server เท่านั้น
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
